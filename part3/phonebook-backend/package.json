{
  "name": "phonebook-backend",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "Claudio Morel",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build:ui": "cd ../phonebook-frontend/ && npm install --no-package-lock && npm run build && rm -rf ../phonebook-backend/dist && cp -r dist ../phonebook-backend",
    "predeploy": "npm run build:ui",
    "deploy": "railway up . --path-as-root -m \"Deploy phonebook backend\"",
    "deploy:ci": "npm run build:ui && railway up . --path-as-root --ci -m \"Deploy phonebook backend\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
